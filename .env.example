# Copy this file to .env and fill in your own values.
# Never commit the real .env file (it's already in .gitignore).

# Private app access token from your HubSpot developer test account
HUBSPOT_ACCESS_TOKEN=your-private-app-access-token-here

# The custom object's type ID (looks like 2-12345678) or fully qualified name
# (looks like p12345678_podcast_episodes). Find this on the object's
# schema/settings page in HubSpot after you create it.
HUBSPOT_CUSTOM_OBJECT_TYPE=your-custom-object-type-id-here
